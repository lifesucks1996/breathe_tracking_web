\pard\plain \s40\li0\widctlpar\adjustright \shading1000\cbpat8 \f2\fs16\cgrid {\bkmkstart AAAAAAAAIH}{\bkmkend AAAAAAAAIH}
{\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAAII" }{}}{\fldrslt {\cs37\ul\cf2 00001}}}
 {\cf22 """}\par
{\bkmkstart AAAAAAAAIJ}{\bkmkend AAAAAAAAIJ}
00002 {\cf22 @file generar_semana_datos.py}\par
{\bkmkstart AAAAAAAAIK}{\bkmkend AAAAAAAAIK}
00003 {\cf22 @brief Script de generaci\'F3n masiva de datos hist\'F3ricos para una semana completa.}\par
{\bkmkstart AAAAAAAAIL}{\bkmkend AAAAAAAAIL}
00004 {\cf22 @details}\par
{\bkmkstart AAAAAAAAIM}{\bkmkend AAAAAAAAIM}
00005 {\cf22 Versi\'F3n optimizada con:}\par
{\bkmkstart AAAAAAAAIN}{\bkmkend AAAAAAAAIN}
00006 {\cf22 - Mayor densidad de puntos (40-60 por gas)}\par
{\bkmkstart AAAAAAAAIO}{\bkmkend AAAAAAAAIO}
00007 {\cf22 - Puntos m\'E1s concentrados (radio reducido)}\par
{\bkmkstart AAAAAAAAIP}{\bkmkend AAAAAAAAIP}
00008 {\cf22 - Valores ajustados para mayor variedad visual}\par
{\bkmkstart AAAAAAAAIQ}{\bkmkend AAAAAAAAIQ}
00009 {\cf22 - Clusters de contaminaci\'F3n realistas}\par
{\bkmkstart AAAAAAAAIR}{\bkmkend AAAAAAAAIR}
00010 {\cf22 """}\par
{\bkmkstart AAAAAAAAIS}{\bkmkend AAAAAAAAIS}
00011 {\cf17 import} firebase_admin\par
{\bkmkstart AAAAAAAAIT}{\bkmkend AAAAAAAAIT}
00012 {\cf17 from} firebase_admin {\cf17 import} credentials\par
{\bkmkstart AAAAAAAAIU}{\bkmkend AAAAAAAAIU}
00013 {\cf17 from} firebase_admin {\cf17 import} firestore\par
{\bkmkstart AAAAAAAAIV}{\bkmkend AAAAAAAAIV}
00014 {\cf17 import} random\par
{\bkmkstart AAAAAAAAIW}{\bkmkend AAAAAAAAIW}
00015 {\cf17 from} datetime {\cf17 import} datetime, timedelta\par
{\bkmkstart AAAAAAAAIX}{\bkmkend AAAAAAAAIX}
00016 {\cf17 import} math\par
{\bkmkstart AAAAAAAAIY}{\bkmkend AAAAAAAAIY}
00017 \par
{\bkmkstart AAAAAAAAIZ}{\bkmkend AAAAAAAAIZ}
00018 {\cf20 # --- 1. CONFIGURACI\'D3N ---}\par
{\bkmkstart AAAAAAAAJA}{\bkmkend AAAAAAAAJA}
{\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAAJB" }{}}{\fldrslt {\cs37\ul\cf2 00019}}}
 cred = credentials.Certificate({\cf22 "serviceAccountKey.json"})\par
{\bkmkstart AAAAAAAAJC}{\bkmkend AAAAAAAAJC}
00020 {\cf19 if} {\cf19 not} firebase_admin._apps:\par
{\bkmkstart AAAAAAAAJD}{\bkmkend AAAAAAAAJD}
00021     firebase_admin.initialize_app(cred)\par
{\bkmkstart AAAAAAAAJE}{\bkmkend AAAAAAAAJE}
{\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAAJF" }{}}{\fldrslt {\cs37\ul\cf2 00022}}}
 db = firestore.client()\par
{\bkmkstart AAAAAAAAJG}{\bkmkend AAAAAAAAJG}
00023 \par
{\bkmkstart AAAAAAAAJH}{\bkmkend AAAAAAAAJH}
00024 {\cf20 # --- 2. PAR\'C1METROS GENERALES ---}\par
{\bkmkstart AAAAAAAAJI}{\bkmkend AAAAAAAAJI}
{\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAAJJ" }{}}{\fldrslt {\cs37\ul\cf2 00025}}}
 FECHA_INICIO = datetime(2025, 12, 1)\par
{\bkmkstart AAAAAAAAJK}{\bkmkend AAAAAAAAJK}
{\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAAJL" }{}}{\fldrslt {\cs37\ul\cf2 00026}}}
 NUM_DIAS = 7\par
{\bkmkstart AAAAAAAAJM}{\bkmkend AAAAAAAAJM}
00027 \par
{\bkmkstart AAAAAAAAJN}{\bkmkend AAAAAAAAJN}
00028 {\cf20 # Centro aproximado de Gand\'EDa}\par
{\bkmkstart AAAAAAAAJO}{\bkmkend AAAAAAAAJO}
{\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAAJP" }{}}{\fldrslt {\cs37\ul\cf2 00029}}}
 LAT_BASE = 38.9660\par
{\bkmkstart AAAAAAAAJQ}{\bkmkend AAAAAAAAJQ}
{\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAAJR" }{}}{\fldrslt {\cs37\ul\cf2 00030}}}
 LNG_BASE = -0.1850\par
{\bkmkstart AAAAAAAAJS}{\bkmkend AAAAAAAAJS}
00031 \par
{\bkmkstart AAAAAAAAJT}{\bkmkend AAAAAAAAJT}
00032 {\cf20 # RADIO M\'C1S PEQUE\'D1O para puntos m\'E1s cercanos (antes: 0.015, ahora: 0.008)}\par
{\bkmkstart AAAAAAAAJU}{\bkmkend AAAAAAAAJU}
{\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAAJV" }{}}{\fldrslt {\cs37\ul\cf2 00033}}}
 RADIO_VARIACION = 0.008  {\cf20 # ~800 metros en lugar de 1.5 km}\par
{\bkmkstart AAAAAAAAJW}{\bkmkend AAAAAAAAJW}
00034 \par
{\bkmkstart AAAAAAAAJX}{\bkmkend AAAAAAAAJX}
00035 {\cf20 # LISTA DE GASES}\par
{\bkmkstart AAAAAAAAJY}{\bkmkend AAAAAAAAJY}
{\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAAJZ" }{}}{\fldrslt {\cs37\ul\cf2 00036}}}
 GASES = [{\cf22 "O3"}, {\cf22 "CO"}, {\cf22 "NO2"}, {\cf22 "SO2"}, {\cf22 "CO2"}]\par
{\bkmkstart AAAAAAAAKA}{\bkmkend AAAAAAAAKA}
00037 \par
{\bkmkstart AAAAAAAAKB}{\bkmkend AAAAAAAAKB}
00038 {\cf20 # RANGOS OPTIMIZADOS para mayor variedad visual}\par
{\bkmkstart AAAAAAAAKC}{\bkmkend AAAAAAAAKC}
{\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAAKD" }{}}{\fldrslt {\cs37\ul\cf2 00039}}}
 RANGOS = \{\par
{\bkmkstart AAAAAAAAKE}{\bkmkend AAAAAAAAKE}
00040     {\cf22 "O3"}:  (0.015, 0.085),  {\cf20 # M\'E1s valores en zona verde/amarilla}\par
{\bkmkstart AAAAAAAAKF}{\bkmkend AAAAAAAAKF}
00041     {\cf22 "CO"}:  (1.0, 25.0),     {\cf20 # Mayor dispersi\'F3n}\par
{\bkmkstart AAAAAAAAKG}{\bkmkend AAAAAAAAKG}
00042     {\cf22 "NO2"}: (10, 320),       {\cf20 # Rango amplio}\par
{\bkmkstart AAAAAAAAKH}{\bkmkend AAAAAAAAKH}
00043     {\cf22 "SO2"}: (5, 420),        {\cf20 # Incluye todos los niveles}\par
{\bkmkstart AAAAAAAAKI}{\bkmkend AAAAAAAAKI}
00044     {\cf22 "CO2"}: (250, 1800)      {\cf20 # M\'E1s variedad verde-amarillo}\par
{\bkmkstart AAAAAAAAKJ}{\bkmkend AAAAAAAAKJ}
00045 \}\par
{\bkmkstart AAAAAAAAKK}{\bkmkend AAAAAAAAKK}
00046 \par
{\bkmkstart AAAAAAAAKL}{\bkmkend AAAAAAAAKL}
{\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAAKM" }{}}{\fldrslt {\cs37\ul\cf2 00047}}}
 {\cf17 def }{\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAAKM" }{}}{\fldrslt {\cs37\ul\cf2 generar_clusters}}}
(lat_centro, lng_centro, num_clusters=3):\par
{\bkmkstart AAAAAAAAKN}{\bkmkend AAAAAAAAKN}
00048     {\cf22 """}\par
{\bkmkstart AAAAAAAAKO}{\bkmkend AAAAAAAAKO}
00049 {\cf22     @brief Genera centros de clusters de contaminaci\'F3n}\par
{\bkmkstart AAAAAAAAKP}{\bkmkend AAAAAAAAKP}
00050 {\cf22     @param lat_centro Centro base latitud}\par
{\bkmkstart AAAAAAAAKQ}{\bkmkend AAAAAAAAKQ}
00051 {\cf22     @param lng_centro Centro base longitud}\par
{\bkmkstart AAAAAAAAKR}{\bkmkend AAAAAAAAKR}
00052 {\cf22     @param num_clusters N\'FAmero de focos de contaminaci\'F3n}\par
{\bkmkstart AAAAAAAAKS}{\bkmkend AAAAAAAAKS}
00053 {\cf22     @return Lista de tuplas (lat, lng) con los centros}\par
{\bkmkstart AAAAAAAAKT}{\bkmkend AAAAAAAAKT}
00054 {\cf22     """}\par
{\bkmkstart AAAAAAAAKU}{\bkmkend AAAAAAAAKU}
00055     clusters = []\par
{\bkmkstart AAAAAAAAKV}{\bkmkend AAAAAAAAKV}
00056     {\cf19 for} _ {\cf19 in} range(num_clusters):\par
{\bkmkstart AAAAAAAAKW}{\bkmkend AAAAAAAAKW}
00057         {\cf20 # Desplazamiento del cluster respecto al centro}\par
{\bkmkstart AAAAAAAAKX}{\bkmkend AAAAAAAAKX}
00058         offset_lat = random.uniform(-RADIO_VARIACION, RADIO_VARIACION)\par
{\bkmkstart AAAAAAAAKY}{\bkmkend AAAAAAAAKY}
00059         offset_lng = random.uniform(-RADIO_VARIACION, RADIO_VARIACION)\par
{\bkmkstart AAAAAAAAKZ}{\bkmkend AAAAAAAAKZ}
00060         clusters.append((lat_centro + offset_lat, lng_centro + offset_lng))\par
{\bkmkstart AAAAAAAALA}{\bkmkend AAAAAAAALA}
00061     {\cf19 return} clusters\par
{\bkmkstart AAAAAAAALB}{\bkmkend AAAAAAAALB}
00062 \par
{\bkmkstart AAAAAAAALC}{\bkmkend AAAAAAAALC}
{\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAALD" }{}}{\fldrslt {\cs37\ul\cf2 00063}}}
 {\cf17 def }{\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAALD" }{}}{\fldrslt {\cs37\ul\cf2 generar_puntos_alrededor_cluster}}}
(lat_cluster, lng_cluster, num_puntos, radio_cluster):\par
{\bkmkstart AAAAAAAALE}{\bkmkend AAAAAAAALE}
00064     {\cf22 """}\par
{\bkmkstart AAAAAAAALF}{\bkmkend AAAAAAAALF}
00065 {\cf22     @brief Genera puntos concentrados alrededor de un cluster}\par
{\bkmkstart AAAAAAAALG}{\bkmkend AAAAAAAALG}
00066 {\cf22     @param lat_cluster Centro del cluster}\par
{\bkmkstart AAAAAAAALH}{\bkmkend AAAAAAAALH}
00067 {\cf22     @param lng_cluster Centro del cluster}\par
{\bkmkstart AAAAAAAALI}{\bkmkend AAAAAAAALI}
00068 {\cf22     @param num_puntos N\'FAmero de puntos a generar}\par
{\bkmkstart AAAAAAAALJ}{\bkmkend AAAAAAAALJ}
00069 {\cf22     @param radio_cluster Radio de dispersi\'F3n del cluster}\par
{\bkmkstart AAAAAAAALK}{\bkmkend AAAAAAAALK}
00070 {\cf22     @return Lista de tuplas (lat, lng)}\par
{\bkmkstart AAAAAAAALL}{\bkmkend AAAAAAAALL}
00071 {\cf22     """}\par
{\bkmkstart AAAAAAAALM}{\bkmkend AAAAAAAALM}
00072     puntos = []\par
{\bkmkstart AAAAAAAALN}{\bkmkend AAAAAAAALN}
00073     {\cf19 for} _ {\cf19 in} range(num_puntos):\par
{\bkmkstart AAAAAAAALO}{\bkmkend AAAAAAAALO}
00074         {\cf20 # Distribuci\'F3n gaussiana para concentrar puntos en el centro}\par
{\bkmkstart AAAAAAAALP}{\bkmkend AAAAAAAALP}
00075         angulo = random.uniform(0, 2 * math.pi)\par
{\bkmkstart AAAAAAAALQ}{\bkmkend AAAAAAAALQ}
00076         {\cf20 # Usar distribuci\'F3n normal para que los puntos est\'E9n m\'E1s cerca del centro}\par
{\bkmkstart AAAAAAAALR}{\bkmkend AAAAAAAALR}
00077         distancia = abs(random.gauss(0, radio_cluster / 2))\par
{\bkmkstart AAAAAAAALS}{\bkmkend AAAAAAAALS}
00078         distancia = min(distancia, radio_cluster)  {\cf20 # Limitar al radio m\'E1ximo}\par
{\bkmkstart AAAAAAAALT}{\bkmkend AAAAAAAALT}
00079         \par
{\bkmkstart AAAAAAAALU}{\bkmkend AAAAAAAALU}
00080         lat = lat_cluster + distancia * math.cos(angulo)\par
{\bkmkstart AAAAAAAALV}{\bkmkend AAAAAAAALV}
00081         lng = lng_cluster + distancia * math.sin(angulo)\par
{\bkmkstart AAAAAAAALW}{\bkmkend AAAAAAAALW}
00082         puntos.append((lat, lng))\par
{\bkmkstart AAAAAAAALX}{\bkmkend AAAAAAAALX}
00083     {\cf19 return} puntos\par
{\bkmkstart AAAAAAAALY}{\bkmkend AAAAAAAALY}
00084 \par
{\bkmkstart AAAAAAAALZ}{\bkmkend AAAAAAAALZ}
{\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAAMA" }{}}{\fldrslt {\cs37\ul\cf2 00085}}}
 {\cf17 def }{\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAAMA" }{}}{\fldrslt {\cs37\ul\cf2 generar_semana}}}
():\par
{\bkmkstart AAAAAAAAMB}{\bkmkend AAAAAAAAMB}
00086     {\cf22 """}\par
{\bkmkstart AAAAAAAAMC}{\bkmkend AAAAAAAAMC}
00087 {\cf22     @brief Ejecuta la simulaci\'F3n y carga de datos para el periodo definido.}\par
{\bkmkstart AAAAAAAAMD}{\bkmkend AAAAAAAAMD}
00088 {\cf22     OPTIMIZADO para mayor densidad y continuidad visual.}\par
{\bkmkstart AAAAAAAAME}{\bkmkend AAAAAAAAME}
00089 {\cf22     """}\par
{\bkmkstart AAAAAAAAMF}{\bkmkend AAAAAAAAMF}
00090     print(f{\cf22 " Iniciando generaci\'F3n OPTIMIZADA para \{NUM_DIAS\} d\'EDas...\\n"})\par
{\bkmkstart AAAAAAAAMG}{\bkmkend AAAAAAAAMG}
00091     \par
{\bkmkstart AAAAAAAAMH}{\bkmkend AAAAAAAAMH}
00092     {\cf19 for} i {\cf19 in} range(NUM_DIAS):\par
{\bkmkstart AAAAAAAAMI}{\bkmkend AAAAAAAAMI}
00093         fecha_actual_obj = FECHA_INICIO + timedelta(days=i)\par
{\bkmkstart AAAAAAAAMJ}{\bkmkend AAAAAAAAMJ}
00094         fecha_str = fecha_actual_obj.strftime({\cf22 "%d-%m-%Y"})\par
{\bkmkstart AAAAAAAAMK}{\bkmkend AAAAAAAAMK}
00095         \par
{\bkmkstart AAAAAAAAML}{\bkmkend AAAAAAAAML}
00096         print(f{\cf22 " Procesando d\'EDa: \{fecha_str\}..."})\par
{\bkmkstart AAAAAAAAMM}{\bkmkend AAAAAAAAMM}
00097         \par
{\bkmkstart AAAAAAAAMN}{\bkmkend AAAAAAAAMN}
00098         {\cf20 # Factor clim\'E1tico del d\'EDa (0.6 = muy limpio, 1.4 = muy contaminado)}\par
{\bkmkstart AAAAAAAAMO}{\bkmkend AAAAAAAAMO}
00099         factor_clima = random.uniform(0.6, 1.4)\par
{\bkmkstart AAAAAAAAMP}{\bkmkend AAAAAAAAMP}
00100         \par
{\bkmkstart AAAAAAAAMQ}{\bkmkend AAAAAAAAMQ}
00101         {\cf20 # Desplazamiento diario de la nube (m\'E1s sutil)}\par
{\bkmkstart AAAAAAAAMR}{\bkmkend AAAAAAAAMR}
00102         move_lat = random.uniform(-0.004, 0.004)\par
{\bkmkstart AAAAAAAAMS}{\bkmkend AAAAAAAAMS}
00103         move_lng = random.uniform(-0.004, 0.004)\par
{\bkmkstart AAAAAAAAMT}{\bkmkend AAAAAAAAMT}
00104         \par
{\bkmkstart AAAAAAAAMU}{\bkmkend AAAAAAAAMU}
00105         {\cf19 for} gas {\cf19 in} GASES:\par
{\bkmkstart AAAAAAAAMV}{\bkmkend AAAAAAAAMV}
00106             val_min, val_max = RANGOS.get(gas, (0, 100))\par
{\bkmkstart AAAAAAAAMW}{\bkmkend AAAAAAAAMW}
00107             \par
{\bkmkstart AAAAAAAAMX}{\bkmkend AAAAAAAAMX}
00108             {\cf20 # GENERAR M\'DALTIPLES CLUSTERS (focos de contaminaci\'F3n)}\par
{\bkmkstart AAAAAAAAMY}{\bkmkend AAAAAAAAMY}
00109             num_clusters = random.randint(2, 4)  {\cf20 # 2-4 focos por gas}\par
{\bkmkstart AAAAAAAAMZ}{\bkmkend AAAAAAAAMZ}
00110             clusters = {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAAKM" }{}}{\fldrslt {\cs37\ul\cf2 generar_clusters}}}
(LAT_BASE + move_lat, LNG_BASE + move_lng, num_clusters)\par
{\bkmkstart AAAAAAAANA}{\bkmkend AAAAAAAANA}
00111             \par
{\bkmkstart AAAAAAAANB}{\bkmkend AAAAAAAANB}
00112             puntos = []\par
{\bkmkstart AAAAAAAANC}{\bkmkend AAAAAAAANC}
00113             \par
{\bkmkstart AAAAAAAAND}{\bkmkend AAAAAAAAND}
00114             {\cf20 # AUMENTAR N\'DAMERO TOTAL DE PUNTOS (40-60 en lugar de 18-25)}\par
{\bkmkstart AAAAAAAANE}{\bkmkend AAAAAAAANE}
00115             num_puntos_total = random.randint(45, 65)\par
{\bkmkstart AAAAAAAANF}{\bkmkend AAAAAAAANF}
00116             puntos_por_cluster = num_puntos_total // num_clusters\par
{\bkmkstart AAAAAAAANG}{\bkmkend AAAAAAAANG}
00117             \par
{\bkmkstart AAAAAAAANH}{\bkmkend AAAAAAAANH}
00118             {\cf20 # Generar puntos para cada cluster}\par
{\bkmkstart AAAAAAAANI}{\bkmkend AAAAAAAANI}
00119             {\cf19 for} cluster_lat, cluster_lng {\cf19 in} clusters:\par
{\bkmkstart AAAAAAAANJ}{\bkmkend AAAAAAAANJ}
00120                 {\cf20 # Radio del cluster m\'E1s peque\'F1o para mayor densidad}\par
{\bkmkstart AAAAAAAANK}{\bkmkend AAAAAAAANK}
00121                 radio_cluster = RADIO_VARIACION * 0.6  {\cf20 # 60% del radio total}\par
{\bkmkstart AAAAAAAANL}{\bkmkend AAAAAAAANL}
00122                 \par
{\bkmkstart AAAAAAAANM}{\bkmkend AAAAAAAANM}
00123                 coords = {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAALD" }{}}{\fldrslt {\cs37\ul\cf2 generar_puntos_alrededor_cluster}}}
(\par
{\bkmkstart AAAAAAAANN}{\bkmkend AAAAAAAANN}
00124                     cluster_lat, \par
{\bkmkstart AAAAAAAANO}{\bkmkend AAAAAAAANO}
00125                     cluster_lng, \par
{\bkmkstart AAAAAAAANP}{\bkmkend AAAAAAAANP}
00126                     puntos_por_cluster,\par
{\bkmkstart AAAAAAAANQ}{\bkmkend AAAAAAAANQ}
00127                     radio_cluster\par
