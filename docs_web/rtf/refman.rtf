 function {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAACGV" }{}}{\fldrslt {\cs37\ul\cf2 parseDateLoose}}}
(dateStr) \{\par
{\bkmkstart AAAAAAACGW}{\bkmkend AAAAAAACGW}
00201     {\cf19 if} (!dateStr) {\cf19 return} 0;\par
{\bkmkstart AAAAAAACGX}{\bkmkend AAAAAAACGX}
00202     {\cf20 // Si es solo hora "14:30", asumimos que es hoy (timestamp mayor)}\par
{\bkmkstart AAAAAAACGY}{\bkmkend AAAAAAACGY}
00203     {\cf19 if} (dateStr.length <= 5) {\cf19 return} {\cf17 new} Date().getTime(); \par
{\bkmkstart AAAAAAACGZ}{\bkmkend AAAAAAACGZ}
00204     \par
{\bkmkstart AAAAAAACHA}{\bkmkend AAAAAAACHA}
00205     {\cf17 const} d = {\cf17 new} Date(dateStr);\par
{\bkmkstart AAAAAAACHB}{\bkmkend AAAAAAACHB}
00206     {\cf19 return} isNaN(d.getTime()) ? 0 : d.getTime();\par
{\bkmkstart AAAAAAACHC}{\bkmkend AAAAAAACHC}
00207 \}\par
