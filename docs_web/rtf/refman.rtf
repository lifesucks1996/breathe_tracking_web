{\bkmkstart AAAAAAAGEI}{\bkmkend AAAAAAAGEI}
00202     {\cf17 const} DISTANCIA_CORTE = 0.05;  {\cf20 // ~5.5km (Si est\'E1s m\'E1s lejos, devuelve 0)}\par
{\bkmkstart AAAAAAAGEJ}{\bkmkend AAAAAAAGEJ}
00203     {\cf17 const} RADIO_VISUAL = 0.035;    {\cf20 // ~3.8km (Radio de influencia para interpolar)}\par
{\bkmkstart AAAAAAAGEK}{\bkmkend AAAAAAAGEK}
