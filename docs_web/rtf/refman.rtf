;\par
{\bkmkstart AAAAAAAFKO}{\bkmkend AAAAAAAFKO}
00238         {\cf19 if} ({\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAFDN" }{}}{\fldrslt {\cs37\ul\cf2 modoAgregar}}}
