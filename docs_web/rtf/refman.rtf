{\bkmkstart AAAAAAAGET}{\bkmkend AAAAAAAGET}
00213 \par
{\bkmkstart AAAAAAAGEU}{\bkmkend AAAAAAAGEU}
00214         {\cf20 // Rastrear siempre el punto m\'E1s cercano absoluto}\par
{\bkmkstart AAAAAAAGEV}{\bkmkend AAAAAAAGEV}
