{\bkmkstart AAAAAAACFR}{\bkmkend AAAAAAACFR}
00172 {\cf20  * @details}\par
{\bkmkstart AAAAAAACFS}{\bkmkend AAAAAAACFS}
00173 {\cf20  * Unifica la l\'F3gica para determinar si un sensor es 'incident', 'inactive' o 'active'}\par
{\bkmkstart AAAAAAACFT}{\bkmkend AAAAAAACFT}
00174 {\cf20  * bas\'E1ndose tanto en los datos simulados (propiedad .active) como en Firebase (.estado).}\par
{\bkmkstart AAAAAAACFU}{\bkmkend AAAAAAACFU}
00175 {\cf20  * * @param \{Object\} sensor - Objeto sensor con propiedades.}\par
{\bkmkstart AAAAAAACFV}{\bkmkend AAAAAAACFV}
00176 {\cf20  * @return \{string\} Estado normalizado: 'incident' | 'inactive' | 'active'.}\par
{\bkmkstart AAAAAAACFW}{\bkmkend AAAAAAACFW}
00177 {\cf20  */}\par
{\bkmkstart AAAAAAACFX}{\bkmkend AAAAAAACFX}
{\field {\*\fldinst { HYPERLINK  \\l "AAAAAAACFY" }{}}{\fldrslt {\cs37\ul\cf2 00178}}}
 function {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAACFY" }{}}{\fldrslt {\cs37\ul\cf2 getSensorStatus}}}
(sensor) \{\par
{\bkmkstart AAAAAAACFZ}{\bkmkend AAAAAAACFZ}
00179     {\cf20 // 1. Incidencia (Prioridad m\'E1xima)}\par
{\bkmkstart AAAAAAACGA}{\bkmkend AAAAAAACGA}
00180     {\cf19 if} (sensor.hasIncident) {\cf19 return} {\cf22 'incident'};\par
{\bkmkstart AAAAAAACGB}{\bkmkend AAAAAAACGB}
00181     {\cf20 // Comprobamos strings de estado comunes en Firebase}\par
{\bkmkstart AAAAAAACGC}{\bkmkend AAAAAAACGC}
00182     {\cf19 if} (sensor.estado && [{\cf22 'alerta'}, {\cf22 'peligro'}, {\cf22 'incidencia'}, {\cf22 'fallo'}].includes(sensor.estado.toLowerCase())) {\cf19 return} {\cf22 'incident'};\par
{\bkmkstart AAAAAAACGD}{\bkmkend AAAAAAACGD}
00183 \par
{\bkmkstart AAAAAAACGE}{\bkmkend AAAAAAACGE}
00184     {\cf20 // 2. Inactivo (Aqu\'ED capturamos el "Desconectado" de Firebase)}\par
{\bkmkstart AAAAAAACGF}{\bkmkend AAAAAAACGF}
00185     {\cf19 if} (sensor.active === {\cf17 false}) {\cf19 return} {\cf22 'inactive'};\par
{\bkmkstart AAAAAAACGG}{\bkmkend AAAAAAACGG}
00186     {\cf19 if} (sensor.estado && [{\cf22 'desconectado'}, {\cf22 'inactivo'}, {\cf22 'baja'}, {\cf22 'off'}].includes(sensor.estado.toLowerCase())) {\cf19 return} {\cf22 'inactive'};\par
{\bkmkstart AAAAAAACGH}{\bkmkend AAAAAAACGH}
00187 \par
{\bkmkstart AAAAAAACGI}{\bkmkend AAAAAAACGI}
00188     {\cf20 // 3. Activo (Por defecto)}\par
{\bkmkstart AAAAAAACGJ}{\bkmkend AAAAAAACGJ}
00189     {\cf19 return} {\cf22 'active'};\par
{\bkmkstart AAAAAAACGK}{\bkmkend AAAAAAACGK}
00190 \}\par
