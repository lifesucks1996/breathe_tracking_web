{\bkmkstart AAAAAAAFFY}{\bkmkend AAAAAAAFFY}
00118 async function cargarMapa() \{\par
{\bkmkstart AAAAAAAFFZ}{\bkmkend AAAAAAAFFZ}
00119     {\cf17 const} fecha = {\cf22 "2025-12-01"}; \par
{\bkmkstart AAAAAAAFGA}{\bkmkend AAAAAAAFGA}
00120     {\cf17 const} gas = {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAFEH" }{}}{\fldrslt {\cs37\ul\cf2 selectorGas}}}
.value;\par
{\bkmkstart AAAAAAAFGB}{\bkmkend AAAAAAAFGB}
00121 \par
{\bkmkstart AAAAAAAFGC}{\bkmkend AAAAAAAFGC}
00122     {\cf19 if} ({\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAFED" }{}}{\fldrslt {\cs37\ul\cf2 loading}}}
) {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAFED" }{}}{\fldrslt {\cs37\ul\cf2 loading}}}
.style.display = {\cf22 'block'};\par
{\bkmkstart AAAAAAAFGD}{\bkmkend AAAAAAAFGD}
00123     {\cf19 if} ({\field {\*\fldinst { HYPERLINK  \\l "AAAAAAACBI" }{}}{\fldrslt {\cs37\ul\cf2 heatmapCongelado}}}
) \{ {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAEBH" }{}}{\fldrslt {\cs37\ul\cf2 mapa}}}
.removeLayer({\field {\*\fldinst { HYPERLINK  \\l "AAAAAAACBI" }{}}{\fldrslt {\cs37\ul\cf2 heatmapCongelado}}}
); {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAACBI" }{}}{\fldrslt {\cs37\ul\cf2 heatmapCongelado}}}
 = null; \}\par
{\bkmkstart AAAAAAAFGE}{\bkmkend AAAAAAAFGE}
00124 \par
{\bkmkstart AAAAAAAFGF}{\bkmkend AAAAAAAFGF}
00125     {\cf19 if} ({\field {\*\fldinst { HYPERLINK  \\l "AAAAAAABPS" }{}}{\fldrslt {\cs37\ul\cf2 window}}}
.obtenerDatosDelSensor) \{\par
{\bkmkstart AAAAAAAFGG}{\bkmkend AAAAAAAFGG}
00126         {\cf17 const} respuesta = await {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAABPS" }{}}{\fldrslt {\cs37\ul\cf2 window}}}
.obtenerDatosDelSensor(fecha, gas);\par
{\bkmkstart AAAAAAAFGH}{\bkmkend AAAAAAAFGH}
00127 \par
{\bkmkstart AAAAAAAFGI}{\bkmkend AAAAAAAFGI}
00128         {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAFDV" }{}}{\fldrslt {\cs37\ul\cf2 datosPuntosActuales}}}
 = respuesta.puntos || [];\par
{\bkmkstart AAAAAAAFGJ}{\bkmkend AAAAAAAFGJ}
00129         {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAACBV" }{}}{\fldrslt {\cs37\ul\cf2 configGasActual}}}
.unidad = respuesta.unidad || {\cf22 'ppm'};\par
{\bkmkstart AAAAAAAFGK}{\bkmkend AAAAAAAFGK}
00130         {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAACBV" }{}}{\fldrslt {\cs37\ul\cf2 configGasActual}}}
.nombre = respuesta.nombre || gas;\par
{\bkmkstart AAAAAAAFGL}{\bkmkend AAAAAAAFGL}
00131         {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAACBV" }{}}{\fldrslt {\cs37\ul\cf2 configGasActual}}}
.umbrales = respuesta.umbrales || [];\par
{\bkmkstart AAAAAAAFGM}{\bkmkend AAAAAAAFGM}
00132         \par
{\bkmkstart AAAAAAAFGN}{\bkmkend AAAAAAAFGN}
00133         {\cf19 if} (respuesta.gradiente) \{\par
{\bkmkstart AAAAAAAFGO}{\bkmkend AAAAAAAFGO}
00134             {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAACBV" }{}}{\fldrslt {\cs37\ul\cf2 configGasActual}}}
.gradiente = respuesta.gradiente;\par
{\bkmkstart AAAAAAAFGP}{\bkmkend AAAAAAAFGP}
00135         \} {\cf19 else} \{\par
{\bkmkstart AAAAAAAFGQ}{\bkmkend AAAAAAAFGQ}
00136             {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAACBV" }{}}{\fldrslt {\cs37\ul\cf2 configGasActual}}}
.gradiente = construirGradienteDesdeUmbrales(respuesta.umbrales);\par
{\bkmkstart AAAAAAAFGR}{\bkmkend AAAAAAAFGR}
00137         \}\par
{\bkmkstart AAAAAAAFGS}{\bkmkend AAAAAAAFGS}
00138 \par
{\bkmkstart AAAAAAAFGT}{\bkmkend AAAAAAAFGT}
00139         {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAACLH" }{}}{\fldrslt {\cs37\ul\cf2 pintarMapaCalor}}}
();\par
{\bkmkstart AAAAAAAFGU}{\bkmkend AAAAAAAFGU}
00140 \par
{\bkmkstart AAAAAAAFGV}{\bkmkend AAAAAAAFGV}
00141         {\cf20 // Actualizar t\'EDtulo en la interfaz}\par
{\bkmkstart AAAAAAAFGW}{\bkmkend AAAAAAAFGW}
00142         {\cf17 const} selectorText = {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAFEH" }{}}{\fldrslt {\cs37\ul\cf2 selectorGas}}}
.options[{\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAFEH" }{}}{\fldrslt {\cs37\ul\cf2 selectorGas}}}
.selectedIndex].text;\par
{\bkmkstart AAAAAAAFGX}{\bkmkend AAAAAAAFGX}
00143         {\cf17 const} tituloGas = {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAAFU" }{}}{\fldrslt {\cs37\ul\cf2 document}}}
.getElementById({\cf22 'activity-contaminant-type'});\par
{\bkmkstart AAAAAAAFGY}{\bkmkend AAAAAAAFGY}
00144         {\cf19 if} (tituloGas) tituloGas.innerText = selectorText;\par
{\bkmkstart AAAAAAAFGZ}{\bkmkend AAAAAAAFGZ}
00145 \par
{\bkmkstart AAAAAAAFHA}{\bkmkend AAAAAAAFHA}
00146         {\cf20 // Actualizar datos del pin seleccionado si lo hay}\par
{\bkmkstart AAAAAAAFHB}{\bkmkend AAAAAAAFHB}
00147         {\cf19 if} ({\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAFDF" }{}}{\fldrslt {\cs37\ul\cf2 idPinSeleccionado}}}
) actualizarSidebar({\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAFDF" }{}}{\fldrslt {\cs37\ul\cf2 idPinSeleccionado}}}
);\par
{\bkmkstart AAAAAAAFHC}{\bkmkend AAAAAAAFHC}
00148     \}\par
{\bkmkstart AAAAAAAFHD}{\bkmkend AAAAAAAFHD}
00149     {\cf19 if} ({\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAFED" }{}}{\fldrslt {\cs37\ul\cf2 loading}}}
) {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAFED" }{}}{\fldrslt {\cs37\ul\cf2 loading}}}
.style.display = {\cf22 'none'};\par
{\bkmkstart AAAAAAAFHE}{\bkmkend AAAAAAAFHE}
00150 \}\par
{\bkmkstart AAAAAAAFHF}{\bkmkend AAAAAAAFHF}
00151 {\cf20 }\par
{\bkmkstart AAAAAAAFHG}{\bkmkend AAAAAAAFHG}
00152 {\cf20 /**}\par
{\bkmkstart AAAAAAAFHH}{\bkmkend AAAAAAAFHH}
00153 {\cf20  * @brief Construye un gradiente de colores a partir de umbrales.}\par
{\bkmkstart AAAAAAAFHI}{\bkmkend AAAAAAAFHI}
00154 {\cf20  * @param \{Array\} umbrales - Lista de niveles de riesgo.}\par
{\bkmkstart AAAAAAAFHJ}{\bkmkend AAAAAAAFHJ}
00155 {\cf20  * @return \{Object\} Objeto gradiente compatible con Leaflet Heat.}\par
{\bkmkstart AAAAAAAFHK}{\bkmkend AAAAAAAFHK}
00156 {\cf20  */}\par
{\bkmkstart AAAAAAAFHL}{\bkmkend AAAAAAAFHL}
00157 function construirGradienteDesdeUmbrales(umbrales) \{\par
{\bkmkstart AAAAAAAFHM}{\bkmkend AAAAAAAFHM}
00158     {\cf19 if} (!umbrales || umbrales.length === 0) \{\par
{\bkmkstart AAAAAAAFHN}{\bkmkend AAAAAAAFHN}
00159         {\cf19 return} \{ 0.0: {\cf22 'rgba(0,0,0,0)'}, 0.2: {\cf22 'green'}, 0.6: {\cf22 'yellow'}, 1.0: {\cf22 'red'} \};\par
{\bkmkstart AAAAAAAFHO}{\bkmkend AAAAAAAFHO}
00160     \}\par
{\bkmkstart AAAAAAAFHP}{\bkmkend AAAAAAAFHP}
00161     {\cf17 const} ordenados = [...umbrales].sort((a, b) => (a.max || 0) - (b.max || 0));\par
{\bkmkstart AAAAAAAFHQ}{\bkmkend AAAAAAAFHQ}
00162     {\cf17 const} gradiente = \{\};\par
{\bkmkstart AAAAAAAFHR}{\bkmkend AAAAAAAFHR}
00163     {\cf17 const} total = ordenados.length - 1;\par
{\bkmkstart AAAAAAAFHS}{\bkmkend AAAAAAAFHS}
00164 \par
{\bkmkstart AAAAAAAFHT}{\bkmkend AAAAAAAFHT}
00165     ordenados.forEach((u, i) => \{\par
{\bkmkstart AAAAAAAFHU}{\bkmkend AAAAAAAFHU}
00166         {\cf17 const} pos = Number((i / total).toFixed(2));\par
{\bkmkstart AAAAAAAFHV}{\bkmkend AAAAAAAFHV}
00167         let col = u.color || {\cf22 '#808080'};\par
{\bkmkstart AAAAAAAFHW}{\bkmkend AAAAAAAFHW}
00168         {\cf20 // Normalizaci\'F3n de nombres de colores}\par
{\bkmkstart AAAAAAAFHX}{\bkmkend AAAAAAAFHX}
00169         {\cf19 if} (col === {\cf22 'orange'}) col = {\cf22 'yellow'};\par
{\bkmkstart AAAAAAAFHY}{\bkmkend AAAAAAAFHY}
00170         {\cf19 if} (col === {\cf22 'purple'}) col = {\cf22 'red'};\par
{\bkmkstart AAAAAAAFHZ}{\bkmkend AAAAAAAFHZ}
00171         gradiente[pos] = hexToRgba(col, 0.85);\par
{\bkmkstart AAAAAAAFIA}{\bkmkend AAAAAAAFIA}
00172     \});\par
{\bkmkstart AAAAAAAFIB}{\bkmkend AAAAAAAFIB}
00173     gradiente[0.0] = {\cf22 'rgba(0,0,0,0)'};\par
{\bkmkstart AAAAAAAFIC}{\bkmkend AAAAAAAFIC}
00174     {\cf19 return} gradiente;\par
{\bkmkstart AAAAAAAFID}{\bkmkend AAAAAAAFID}
00175 \}\par
{\bkmkstart AAAAAAAFIE}{\bkmkend AAAAAAAFIE}
00176 {\cf20 }\par
{\bkmkstart AAAAAAAFIF}{\bkmkend AAAAAAAFIF}
00177 {\cf20 /**}\par
{\bkmkstart AAAAAAAFIG}{\bkmkend AAAAAAAFIG}
00178 {\cf20  * @brief Convierte color HEX a RGBA.}\par
{\bkmkstart AAAAAAAFIH}{\bkmkend AAAAAAAFIH}
00179 {\cf20  * @param \{string\} hex - Color hexadecimal (ej: "#ff0000").}\par
{\bkmkstart AAAAAAAFII}{\bkmkend AAAAAAAFII}
00180 {\cf20  * @param \{number\} alpha - Opacidad (0-1).}\par
{\bkmkstart AAAAAAAFIJ}{\bkmkend AAAAAAAFIJ}
00181 {\cf20  * @return \{string\} Color en formato `rgba(r,g,b,a)`.}\par
{\bkmkstart AAAAAAAFIK}{\bkmkend AAAAAAAFIK}
00182 {\cf20  */}\par
{\bkmkstart AAAAAAAFIL}{\bkmkend AAAAAAAFIL}
00183 function hexToRgba(hex, alpha) \{\par
{\bkmkstart AAAAAAAFIM}{\bkmkend AAAAAAAFIM}
00184     hex = hex.replace({\cf23 '#'}, {\cf22 ''});\par
{\bkmkstart AAAAAAAFIN}{\bkmkend AAAAAAAFIN}
00185     {\cf17 const} r = parseInt(hex.substring(0, 2), 16);\par
{\bkmkstart AAAAAAAFIO}{\bkmkend AAAAAAAFIO}
00186     {\cf17 const} g = parseInt(hex.substring(2, 4), 16);\par
{\bkmkstart AAAAAAAFIP}{\bkmkend AAAAAAAFIP}
00187     {\cf17 const} b = parseInt(hex.substring(4, 6), 16);\par
{\bkmkstart AAAAAAAFIQ}{\bkmkend AAAAAAAFIQ}
00188     {\cf19 return} `rgba($\{r\}, $\{g\}, $\{b\}, $\{alpha\})`;\par
{\bkmkstart AAAAAAAFIR}{\bkmkend AAAAAAAFIR}
00189 \}\par
{\bkmkstart AAAAAAAFIS}{\bkmkend AAAAAAAFIS}
00190 \par
{\bkmkstart AAAAAAAFIT}{\bkmkend AAAAAAAFIT}
00191 {\cf20 // ========================= 3. PINTADO DEL MAPA =========================}\par
{\bkmkstart AAAAAAAFIU}{\bkmkend AAAAAAAFIU}
00192 {\cf20 }\par
{\bkmkstart AAAAAAAFIV}{\bkmkend AAAAAAAFIV}
00193 {\cf20 /**}\par
{\bkmkstart AAAAAAAFIW}{\bkmkend AAAAAAAFIW}
00194 {\cf20  * @brief Renderiza la capa de calor en el mapa.}\par
{\bkmkstart AAAAAAAFIX}{\bkmkend AAAAAAAFIX}
00195 {\cf20  * @details}\par
{\bkmkstart AAAAAAAFIY}{\bkmkend AAAAAAAFIY}
00196 {\cf20  * Utiliza `L.heatLayer` para dibujar los puntos. Luego congela la capa}\par
{\bkmkstart AAAAAAAFIZ}{\bkmkend AAAAAAAFIZ}
00197 {\cf20  * convirti\'E9ndola en una imagen (`L.imageOverlay`) para mejorar el rendimiento al hacer zoom/pan.}\par
{\bkmkstart AAAAAAAFJA}{\bkmkend AAAAAAAFJA}
00198 {\cf20  */}\par
{\bkmkstart AAAAAAAFJB}{\bkmkend AAAAAAAFJB}
00199 function {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAACLH" }{}}{\fldrslt {\cs37\ul\cf2 pintarMapaCalor}}}
() \{\par
{\bkmkstart AAAAAAAFJC}{\bkmkend AAAAAAAFJC}
00200     {\cf19 if} (!{\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAFDV" }{}}{\fldrslt {\cs37\ul\cf2 datosPuntosActuales}}}
.length || !L.heatLayer) {\cf19 return};\par
{\bkmkstart AAAAAAAFJD}{\bkmkend AAAAAAAFJD}
00201 \par
{\bkmkstart AAAAAAAFJE}{\bkmkend AAAAAAAFJE}
00202     {\cf20 // TRUCO DE INTENSIDAD:}\par
{\bkmkstart AAAAAAAFJF}{\bkmkend AAAAAAAFJF}
00203     {\cf20 // Fijamos max en 0.8 para asegurar saturaci\'F3n visual en colores rojos.}\par
{\bkmkstart AAAAAAAFJG}{\bkmkend AAAAAAAFJG}
00204     {\cf17 const} maxVal = 0.8; \par
{\bkmkstart AAAAAAAFJH}{\bkmkend AAAAAAAFJH}
00205 \par
{\bkmkstart AAAAAAAFJI}{\bkmkend AAAAAAAFJI}
00206     {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAACBB" }{}}{\fldrslt {\cs37\ul\cf2 capaCalor}}}
 = L.heatLayer({\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAFDV" }{}}{\fldrslt {\cs37\ul\cf2 datosPuntosActuales}}}
, \{\par
{\bkmkstart AAAAAAAFJJ}{\bkmkend AAAAAAAFJJ}
00207         radius: 45, \par
{\bkmkstart AAAAAAAFJK}{\bkmkend AAAAAAAFJK}
00208         blur: 35, \par
{\bkmkstart AAAAAAAFJL}{\bkmkend AAAAAAAFJL}
00209         minOpacity: 0.3, \par
{\bkmkstart AAAAAAAFJM}{\bkmkend AAAAAAAFJM}
00210         max: maxVal, \par
{\bkmkstart AAAAAAAFJN}{\bkmkend AAAAAAAFJN}
00211         gradient: {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAACBV" }{}}{\fldrslt {\cs37\ul\cf2 configGasActual}}}
.gradiente\par
{\bkmkstart AAAAAAAFJO}{\bkmkend AAAAAAAFJO}
00212     \}).{\field {\*\fldinst { HYPERLINK  \\l "AAAAAAABQE" }{}}{\fldrslt {\cs37\ul\cf2 addTo}}}
({\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAEBH" }{}}{\fldrslt {\cs37\ul\cf2 mapa}}}
);\par
{\bkmkstart AAAAAAAFJP}{\bkmkend AAAAAAAFJP}
00213 \par
{\bkmkstart AAAAAAAFJQ}{\bkmkend AAAAAAAFJQ}
00214     {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAEBH" }{}}{\fldrslt {\cs37\ul\cf2 mapa}}}
.setZoom({\field {\*\fldinst { HYPERLINK  \\l "AAAAAAACBP" }{}}{\fldrslt {\cs37\ul\cf2 ZOOM_CONGELADO}}}
);\par
{\bkmkstart AAAAAAAFJR}{\bkmkend AAAAAAAFJR}
00215     \par
{\bkmkstart AAAAAAAFJS}{\bkmkend AAAAAAAFJS}
00216     {\cf20 // Congelado as\'EDncrono}\par
{\bkmkstart AAAAAAAFJT}{\bkmkend AAAAAAAFJT}
00217     setTimeout(() => \{\par
{\bkmkstart AAAAAAAFJU}{\bkmkend AAAAAAAFJU}
00218         {\cf19 if} (!{\field {\*\fldinst { HYPERLINK  \\l "AAAAAAACBB" }{}}{\fldrslt {\cs37\ul\cf2 capaCalor}}}
 || !{\field {\*\fldinst { HYPERLINK  \\l "AAAAAAACBB" }{}}{\fldrslt {\cs37\ul\cf2 capaCalor}}}
._canvas) {\cf19 return};\par
{\bkmkstart AAAAAAAFJV}{\bkmkend AAAAAAAFJV}
00219         {\cf17 const} imgData = {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAACBB" }{}}{\fldrslt {\cs37\ul\cf2 capaCalor}}}
._canvas.toDataURL({\cf22 'image/png'});\par
{\bkmkstart AAAAAAAFJW}{\bkmkend AAAAAAAFJW}
00220         {\cf17 const} bounds = {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAEBH" }{}}{\fldrslt {\cs37\ul\cf2 mapa}}}
.getBounds();\par
{\bkmkstart AAAAAAAFJX}{\bkmkend AAAAAAAFJX}
00221         {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAEBH" }{}}{\fldrslt {\cs37\ul\cf2 mapa}}}
.removeLayer({\field {\*\fldinst { HYPERLINK  \\l "AAAAAAACBB" }{}}{\fldrslt {\cs37\ul\cf2 capaCalor}}}
);\par
{\bkmkstart AAAAAAAFJY}{\bkmkend AAAAAAAFJY}
00222         {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAACBB" }{}}{\fldrslt {\cs37\ul\cf2 capaCalor}}}
 = null;\par
{\bkmkstart AAAAAAAFJZ}{\bkmkend AAAAAAAFJZ}
00223         {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAACBI" }{}}{\fldrslt {\cs37\ul\cf2 heatmapCongelado}}}
 = L.imageOverlay(imgData, bounds, \{ opacity: 0.85, interactive: {\cf17 false} \}).{\field {\*\fldinst { HYPERLINK  \\l "AAAAAAABQE" }{}}{\fldrslt {\cs37\ul\cf2 addTo}}}
({\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAEBH" }{}}{\fldrslt {\cs37\ul\cf2 mapa}}}
);\par
{\bkmkstart AAAAAAAFKA}{\bkmkend AAAAAAAFKA}
00224     \}, 400); \par
{\bkmkstart AAAAAAAFKB}{\bkmkend AAAAAAAFKB}
00225 \}\par
{\bkmkstart AAAAAAAFKC}{\bkmkend AAAAAAAFKC}
00226 \par
{\bkmkstart AAAAAAAFKD}{\bkmkend AAAAAAAFKD}
00227 {\cf20 // ========================= 4. GESTI\'D3N DE PINES =========================}\par
{\bkmkstart AAAAAAAFKE}{\bkmkend AAAAAAAFKE}
00228 \par
{\bkmkstart AAAAAAAFKF}{\bkmkend AAAAAAAFKF}
00229 {\cf17 const} btnAdd = {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAAFU" }{}}{\fldrslt {\cs37\ul\cf2 document}}}
.getElementById({\cf22 'add-pin-btn'});\par
{\bkmkstart AAAAAAAFKG}{\bkmkend AAAAAAAFKG}
00230 {\cf17 const} modal = {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAAFU" }{}}{\fldrslt {\cs37\ul\cf2 document}}}
.getElementById({\cf22 'name-pin-modal'});\par
{\bkmkstart AAAAAAAFKH}{\bkmkend AAAAAAAFKH}
00231 {\cf17 const} inputName = {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAAFU" }{}}{\fldrslt {\cs37\ul\cf2 document}}}
.getElementById({\cf22 'new-pin-name-input'});\par
{\bkmkstart AAAAAAAFKI}{\bkmkend AAAAAAAFKI}
00232 {\cf17 const} btnConfirm = {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAAFU" }{}}{\fldrslt {\cs37\ul\cf2 document}}}
.getElementById({\cf22 'confirm-add-btn'});\par
{\bkmkstart AAAAAAAFKJ}{\bkmkend AAAAAAAFKJ}
00233 {\cf17 const} btnCancel = {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAAFU" }{}}{\fldrslt {\cs37\ul\cf2 document}}}
.getElementById({\cf22 'cancel-add-btn'});\par
{\bkmkstart AAAAAAAFKK}{\bkmkend AAAAAAAFKK}
00234 \par
