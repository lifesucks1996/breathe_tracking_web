{\bkmkstart AAAAAAAECX}{\bkmkend AAAAAAAECX}
00079     {\cf17 const} url = `https:{\cf20 //api.waqi.info/map/bounds/?latlng=$\{lat1\},$\{lng1\},$\{lat2\},$\{lng2\}&token=$\{WAQI_TOKEN\}`;}\par
{\bkmkstart AAAAAAAECY}{\bkmkend AAAAAAAECY}
00080 \par
{\bkmkstart AAAAAAAECZ}{\bkmkend AAAAAAAECZ}
00081     {\cf19 try} \{\par
{\bkmkstart AAAAAAAEDA}{\bkmkend AAAAAAAEDA}
00082         {\cf17 const} respuesta = await fetch(url);\par
{\bkmkstart AAAAAAAEDB}{\bkmkend AAAAAAAEDB}
00083         {\cf17 const} datos = await respuesta.json();\par
{\bkmkstart AAAAAAAEDC}{\bkmkend AAAAAAAEDC}
00084 \par
{\bkmkstart AAAAAAAEDD}{\bkmkend AAAAAAAEDD}
00085         {\cf19 if} (datos.status === {\cf22 'ok'}) \{\par
{\bkmkstart AAAAAAAEDE}{\bkmkend AAAAAAAEDE}
00086             console.log(` Estaciones encontradas: $\{datos.data.length\}`);\par
{\bkmkstart AAAAAAAEDF}{\bkmkend AAAAAAAEDF}
00087             {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAEDG" }{}}{\fldrslt {\cs37\ul\cf2 dibujarEstacionesComoIconos}}}
(datos.data);\par
{\bkmkstart AAAAAAAEDH}{\bkmkend AAAAAAAEDH}
00088         \} {\cf19 else} \{\par
{\bkmkstart AAAAAAAEDI}{\bkmkend AAAAAAAEDI}
00089             console.warn({\cf22 " API WAQI Error:"}, datos.data);\par
{\bkmkstart AAAAAAAEDJ}{\bkmkend AAAAAAAEDJ}
00090         \}\par
{\bkmkstart AAAAAAAEDK}{\bkmkend AAAAAAAEDK}
00091     \} {\cf19 catch} (error) \{\par
{\bkmkstart AAAAAAAEDL}{\bkmkend AAAAAAAEDL}
00092         console.error({\cf22 " Error conectando con estaciones:"}, error);\par
{\bkmkstart AAAAAAAEDM}{\bkmkend AAAAAAAEDM}
00093     \}\par
{\bkmkstart AAAAAAAEDN}{\bkmkend AAAAAAAEDN}
00094 \}\par
{\bkmkstart AAAAAAAEDO}{\bkmkend AAAAAAAEDO}
00095 {\cf20 }\par
{\bkmkstart AAAAAAAEDP}{\bkmkend AAAAAAAEDP}
00096 {\cf20 /**}\par
{\bkmkstart AAAAAAAEDQ}{\bkmkend AAAAAAAEDQ}
00097 {\cf20  * @brief Renderiza las estaciones recibidas como iconos en el mapa.}\par
{\bkmkstart AAAAAAAEDR}{\bkmkend AAAAAAAEDR}
00098 {\cf20  * @details}\par
{\bkmkstart AAAAAAAEDS}{\bkmkend AAAAAAAEDS}
00099 {\cf20  * 1. Limpia los marcadores antiguos de `capaEstaciones`.}\par
{\bkmkstart AAAAAAAEDT}{\bkmkend AAAAAAAEDT}
00100 {\cf20  * 2. Itera sobre cada estaci\'F3n recibida.}\par
{\bkmkstart AAAAAAAEDU}{\bkmkend AAAAAAAEDU}
00101 {\cf20  * 3. Crea un `L.divIcon` personalizado con el color correspondiente al AQI.}\par
{\bkmkstart AAAAAAAEDV}{\bkmkend AAAAAAAEDV}
00102 {\cf20  * 4. A\'F1ade un tooltip y un evento click para ver detalles.}\par
{\bkmkstart AAAAAAAEDW}{\bkmkend AAAAAAAEDW}
00103 {\cf20  *}\par
{\bkmkstart AAAAAAAEDX}{\bkmkend AAAAAAAEDX}
00104 {\cf20  * @param \{Array<Object>\} estaciones - Lista de estaciones devuelta por la API.}\par
{\bkmkstart AAAAAAAEDY}{\bkmkend AAAAAAAEDY}
00105 {\cf20  */}\par
{\bkmkstart AAAAAAAEDZ}{\bkmkend AAAAAAAEDZ}
{\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAEDG" }{}}{\fldrslt {\cs37\ul\cf2 00106}}}
 function {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAEDG" }{}}{\fldrslt {\cs37\ul\cf2 dibujarEstacionesComoIconos}}}
(estaciones) \{\par
{\bkmkstart AAAAAAAEEA}{\bkmkend AAAAAAAEEA}
00107     {\cf20 // Limpieza previa}\par
{\bkmkstart AAAAAAAEEB}{\bkmkend AAAAAAAEEB}
00108     {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAEAT" }{}}{\fldrslt {\cs37\ul\cf2 capaEstaciones}}}
.clearLayers(); \par
{\bkmkstart AAAAAAAEEC}{\bkmkend AAAAAAAEEC}
00109 \par
{\bkmkstart AAAAAAAEED}{\bkmkend AAAAAAAEED}
00110     estaciones.forEach(est => \{\par
{\bkmkstart AAAAAAAEEE}{\bkmkend AAAAAAAEEE}
00111         {\cf20 // Filtrar estaciones sin datos validos}\par
{\bkmkstart AAAAAAAEEF}{\bkmkend AAAAAAAEEF}
00112         {\cf19 if} (est.aqi === {\cf23 '-'}) {\cf19 return}; \par
{\bkmkstart AAAAAAAEEG}{\bkmkend AAAAAAAEEG}
00113 \par
{\bkmkstart AAAAAAAEEH}{\bkmkend AAAAAAAEEH}
00114         {\cf17 const} valorAQI = parseInt(est.aqi);\par
{\bkmkstart AAAAAAAEEI}{\bkmkend AAAAAAAEEI}
00115         {\cf17 const} colorFondo = {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAEEJ" }{}}{\fldrslt {\cs37\ul\cf2 obtenerColorAQI}}}
(valorAQI);\par
{\bkmkstart AAAAAAAEEK}{\bkmkend AAAAAAAEEK}
00116 \par
{\bkmkstart AAAAAAAEEL}{\bkmkend AAAAAAAEEL}
00117         {\cf20 // Icono HTML personalizado}\par
{\bkmkstart AAAAAAAEEM}{\bkmkend AAAAAAAEEM}
00118         {\cf17 const} iconoOficial = L.divIcon(\{\par
{\bkmkstart AAAAAAAEEN}{\bkmkend AAAAAAAEEN}
00119             className: {\cf22 ''}, {\cf20 // Sin clases por defecto de Leaflet}\par
{\bkmkstart AAAAAAAEEO}{\bkmkend AAAAAAAEEO}
00120             html: `\par
{\bkmkstart AAAAAAAEEP}{\bkmkend AAAAAAAEEP}
00121                 <div {\cf17 class}={\cf22 "station-icon-marker"} style={\cf22 "background-color: $\{colorFondo\}; width: 30px; height: 30px;"}>\par
{\bkmkstart AAAAAAAEEQ}{\bkmkend AAAAAAAEEQ}
00122                     <i {\cf17 class}={\cf22 "fas fa-broadcast-tower"}></i>\par
{\bkmkstart AAAAAAAEER}{\bkmkend AAAAAAAEER}
00123                 </div>\par
{\bkmkstart AAAAAAAEES}{\bkmkend AAAAAAAEES}
00124             `,\par
{\bkmkstart AAAAAAAEET}{\bkmkend AAAAAAAEET}
00125             iconSize: [30, 30],\par
{\bkmkstart AAAAAAAEEU}{\bkmkend AAAAAAAEEU}
00126             iconAnchor: [15, 15],\par
{\bkmkstart AAAAAAAEEV}{\bkmkend AAAAAAAEEV}
00127             popupAnchor: [0, -20]\par
{\bkmkstart AAAAAAAEEW}{\bkmkend AAAAAAAEEW}
00128         \});\par
{\bkmkstart AAAAAAAEEX}{\bkmkend AAAAAAAEEX}
00129 \par
{\bkmkstart AAAAAAAEEY}{\bkmkend AAAAAAAEEY}
00130         {\cf20 // Creaci\'F3n del marcador}\par
{\bkmkstart AAAAAAAEEZ}{\bkmkend AAAAAAAEEZ}
00131         {\cf17 const} marker = L.marker([est.lat, est.lon], \{ \par
{\bkmkstart AAAAAAAEFA}{\bkmkend AAAAAAAEFA}
00132             icon: iconoOficial,\par
{\bkmkstart AAAAAAAEFB}{\bkmkend AAAAAAAEFB}
00133             zIndexOffset: 1000 {\cf20 // Prioridad visual alta}\par
{\bkmkstart AAAAAAAEFC}{\bkmkend AAAAAAAEFC}
00134         \});\par
{\bkmkstart AAAAAAAEFD}{\bkmkend AAAAAAAEFD}
00135 \par
{\bkmkstart AAAAAAAEFE}{\bkmkend AAAAAAAEFE}
00136         {\cf20 // Tooltip b\'E1sico (hover)}\par
{\bkmkstart AAAAAAAEFF}{\bkmkend AAAAAAAEFF}
00137         marker.bindTooltip(`\par
{\bkmkstart AAAAAAAEFG}{\bkmkend AAAAAAAEFG}
00138             <div style={\cf22 "text-align:center"}>\par
{\bkmkstart AAAAAAAEFH}{\bkmkend AAAAAAAEFH}
00139                 <strong>$\{est.station.name\}</strong><br>\par
{\bkmkstart AAAAAAAEFI}{\bkmkend AAAAAAAEFI}
00140                 Estaci\'F3n Oficial<br>\par
{\bkmkstart AAAAAAAEFJ}{\bkmkend AAAAAAAEFJ}
00141                 AQI: $\{est.aqi\}\par
{\bkmkstart AAAAAAAEFK}{\bkmkend AAAAAAAEFK}
00142             </div>\par
{\bkmkstart AAAAAAAEFL}{\bkmkend AAAAAAAEFL}
00143         `, \{ direction: {\cf22 'top'}, offset: [0, -20] \});\par
{\bkmkstart AAAAAAAEFM}{\bkmkend AAAAAAAEFM}
00144 \par
{\bkmkstart AAAAAAAEFN}{\bkmkend AAAAAAAEFN}
00145         {\cf20 // Evento Click: Cargar detalles}\par
{\bkmkstart AAAAAAAEFO}{\bkmkend AAAAAAAEFO}
00146         marker.on({\cf22 'click'}, (e) => \{\par
{\bkmkstart AAAAAAAEFP}{\bkmkend AAAAAAAEFP}
00147             L.DomEvent.stopPropagation(e); {\cf20 // Evitar propagaci\'F3n al mapa}\par
{\bkmkstart AAAAAAAEFQ}{\bkmkend AAAAAAAEFQ}
00148             {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAEFR" }{}}{\fldrslt {\cs37\ul\cf2 mostrarPopupDetalle}}}
(est, marker);\par
{\bkmkstart AAAAAAAEFS}{\bkmkend AAAAAAAEFS}
00149         \});\par
{\bkmkstart AAAAAAAEFT}{\bkmkend AAAAAAAEFT}
00150 \par
{\bkmkstart AAAAAAAEFU}{\bkmkend AAAAAAAEFU}
00151         {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAEAT" }{}}{\fldrslt {\cs37\ul\cf2 capaEstaciones}}}
.addLayer(marker);\par
{\bkmkstart AAAAAAAEFV}{\bkmkend AAAAAAAEFV}
00152     \});\par
{\bkmkstart AAAAAAAEFW}{\bkmkend AAAAAAAEFW}
00153 \}\par
{\bkmkstart AAAAAAAEFX}{\bkmkend AAAAAAAEFX}
00154 {\cf20 }\par
{\bkmkstart AAAAAAAEFY}{\bkmkend AAAAAAAEFY}
00155 {\cf20 /**}\par
{\bkmkstart AAAAAAAEFZ}{\bkmkend AAAAAAAEFZ}
00156 {\cf20  * @brief Carga y muestra los detalles completos de una estaci\'F3n en un popup.}\par
{\bkmkstart AAAAAAAEGA}{\bkmkend AAAAAAAEGA}
00157 {\cf20  * @details}\par
{\bkmkstart AAAAAAAEGB}{\bkmkend AAAAAAAEGB}
00158 {\cf20  * Realiza una segunda petici\'F3n a la API usando el UID de la estaci\'F3n para obtener}\par
{\bkmkstart AAAAAAAEGC}{\bkmkend AAAAAAAEGC}
00159 {\cf20  * desglose de contaminantes (PM2.5, PM10, O3, etc.) y metadatos.}\par
{\bkmkstart AAAAAAAEGD}{\bkmkend AAAAAAAEGD}
00160 {\cf20  *}\par
{\bkmkstart AAAAAAAEGE}{\bkmkend AAAAAAAEGE}
00161 {\cf20  * @param \{Object\} estacionResumen - Datos b\'E1sicos de la estaci\'F3n (incluye UID).}\par
{\bkmkstart AAAAAAAEGF}{\bkmkend AAAAAAAEGF}
00162 {\cf20  * @param \{L.Marker\} marker - El marcador sobre el cual abrir el popup.}\par
{\bkmkstart AAAAAAAEGG}{\bkmkend AAAAAAAEGG}
00163 {\cf20  * @async}\par
{\bkmkstart AAAAAAAEGH}{\bkmkend AAAAAAAEGH}
00164 {\cf20  */}\par
{\bkmkstart AAAAAAAEGI}{\bkmkend AAAAAAAEGI}
{\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAEFR" }{}}{\fldrslt {\cs37\ul\cf2 00165}}}
 async function {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAEFR" }{}}{\fldrslt {\cs37\ul\cf2 mostrarPopupDetalle}}}
(estacionResumen, marker) \{\par
{\bkmkstart AAAAAAAEGJ}{\bkmkend AAAAAAAEGJ}
00166     {\cf17 const} popupOptions = \{\par
{\bkmkstart AAAAAAAEGK}{\bkmkend AAAAAAAEGK}
00167         autoPan: {\cf17 false}, {\cf20 // Evita mover el mapa para no disparar recargas}\par
{\bkmkstart AAAAAAAEGL}{\bkmkend AAAAAAAEGL}
00168         className: {\cf22 'official-popup-container'}\par
{\bkmkstart AAAAAAAEGM}{\bkmkend AAAAAAAEGM}
00169     \};\par
{\bkmkstart AAAAAAAEGN}{\bkmkend AAAAAAAEGN}
00170 \par
{\bkmkstart AAAAAAAEGO}{\bkmkend AAAAAAAEGO}
00171     {\cf20 // Popup temporal de carga}\par
{\bkmkstart AAAAAAAEGP}{\bkmkend AAAAAAAEGP}
00172     marker.bindPopup({\cf22 '<div style="padding:10px; text-align:center; color:#5BA3F5"><i class="fas fa-spinner fa-spin"></i> Conectando...</div>'}, popupOptions).openPopup();\par
{\bkmkstart AAAAAAAEGQ}{\bkmkend AAAAAAAEGQ}
00173 \par
{\bkmkstart AAAAAAAEGR}{\bkmkend AAAAAAAEGR}
00174     {\cf20 // URL de detalle por UID}\par
{\bkmkstart AAAAAAAEGS}{\bkmkend AAAAAAAEGS}
00175     {\cf17 const} url = `https:{\cf20 //api.waqi.info/feed/@$\{estacionResumen.uid\}/?token=$\{WAQI_TOKEN\}`;}\par
{\bkmkstart AAAAAAAEGT}{\bkmkend AAAAAAAEGT}
00176 \par
{\bkmkstart AAAAAAAEGU}{\bkmkend AAAAAAAEGU}
00177     {\cf19 try} \{\par
{\bkmkstart AAAAAAAEGV}{\bkmkend AAAAAAAEGV}
00178         {\cf17 const} res = await fetch(url);\par
{\bkmkstart AAAAAAAEGW}{\bkmkend AAAAAAAEGW}
00179         {\cf17 const} json = await res.json();\par
{\bkmkstart AAAAAAAEGX}{\bkmkend AAAAAAAEGX}
00180 \par
{\bkmkstart AAAAAAAEGY}{\bkmkend AAAAAAAEGY}
00181         {\cf19 if} (json.status === {\cf22 'ok'}) \{\par
{\bkmkstart AAAAAAAEGZ}{\bkmkend AAAAAAAEGZ}
00182             {\cf17 const} d = json.data;\par
{\bkmkstart AAAAAAAEHA}{\bkmkend AAAAAAAEHA}
00183             {\cf17 const} iaqa = d.iaqi;\par
{\bkmkstart AAAAAAAEHB}{\bkmkend AAAAAAAEHB}
00184             \par
{\bkmkstart AAAAAAAEHC}{\bkmkend AAAAAAAEHC}
00185             {\cf20 // Diccionario de traducci\'F3n de contaminantes}\par
{\bkmkstart AAAAAAAEHD}{\bkmkend AAAAAAAEHD}
00186             {\cf17 const} nombres = \{\par
{\bkmkstart AAAAAAAEHE}{\bkmkend AAAAAAAEHE}
00187                 pm25: {\cf22 "PM 2.5"}, pm10: {\cf22 "PM 10"}, o3: {\cf22 "Ozono (O\'E2\'82\'83)"}, \par
{\bkmkstart AAAAAAAEHF}{\bkmkend AAAAAAAEHF}
00188                 no2: {\cf22 "NO\'E2\'82\'82"}, so2: {\cf22 "SO\'E2\'82\'82"}, co: {\cf22 "CO"},\par
{\bkmkstart AAAAAAAEHG}{\bkmkend AAAAAAAEHG}
00189                 t: {\cf22 "Temp."}, h: {\cf22 "Humedad"}, w: {\cf22 "Viento"}, p: {\cf22 "Presi\'F3n"}\par
{\bkmkstart AAAAAAAEHH}{\bkmkend AAAAAAAEHH}
00190             \};\par
{\bkmkstart AAAAAAAEHI}{\bkmkend AAAAAAAEHI}
00191 \par
{\bkmkstart AAAAAAAEHJ}{\bkmkend AAAAAAAEHJ}
00192             {\cf20 // Generaci\'F3n de lista HTML}\par
{\bkmkstart AAAAAAAEHK}{\bkmkend AAAAAAAEHK}
00193             let listadoHtml = {\cf22 ''};\par
{\bkmkstart AAAAAAAEHL}{\bkmkend AAAAAAAEHL}
00194             {\cf19 for} ({\cf17 const} [key, val] of Object.entries(iaqa)) \{\par
{\bkmkstart AAAAAAAEHM}{\bkmkend AAAAAAAEHM}
00195                 {\cf19 if} (nombres[key]) \{\par
{\bkmkstart AAAAAAAEHN}{\bkmkend AAAAAAAEHN}
00196                     listadoHtml += `\par
{\bkmkstart AAAAAAAEHO}{\bkmkend AAAAAAAEHO}
00197                         <li>\par
{\bkmkstart AAAAAAAEHP}{\bkmkend AAAAAAAEHP}
00198                             <span {\cf17 class}={\cf22 "gas-name"}>$\{nombres[key]\}</span>\par
{\bkmkstart AAAAAAAEHQ}{\bkmkend AAAAAAAEHQ}
00199                             <span {\cf17 class}={\cf22 "gas-value"}>$\{val.v\}</span>\par
{\bkmkstart AAAAAAAEHR}{\bkmkend AAAAAAAEHR}
00200                         </li>`;\par
{\bkmkstart AAAAAAAEHS}{\bkmkend AAAAAAAEHS}
00201                 \}\par
{\bkmkstart AAAAAAAEHT}{\bkmkend AAAAAAAEHT}
00202             \}\par
{\bkmkstart AAAAAAAEHU}{\bkmkend AAAAAAAEHU}
00203 \par
{\bkmkstart AAAAAAAEHV}{\bkmkend AAAAAAAEHV}
00204             {\cf20 // Construcci\'F3n del HTML final}\par
{\bkmkstart AAAAAAAEHW}{\bkmkend AAAAAAAEHW}
00205             {\cf17 const} html = `\par
{\bkmkstart AAAAAAAEHX}{\bkmkend AAAAAAAEHX}
00206                 <div {\cf17 class}={\cf22 "official-popup"}>\par
{\bkmkstart AAAAAAAEHY}{\bkmkend AAAAAAAEHY}
00207                     <div {\cf17 class}={\cf22 "popup-header"} style={\cf22 "background-color: $\{obtenerColorAQI(d.aqi)\}"}>\par
{\bkmkstart AAAAAAAEHZ}{\bkmkend AAAAAAAEHZ}
00208                         <span {\cf17 class}={\cf22 "city-name"}>$\{d.city.name.split({\cf23 ','})[0]\}</span>\par
{\bkmkstart AAAAAAAEIA}{\bkmkend AAAAAAAEIA}
00209                         <span {\cf17 class}={\cf22 "aqi-badge"}>AQI $\{d.aqi\}</span>\par
{\bkmkstart AAAAAAAEIB}{\bkmkend AAAAAAAEIB}
00210                     </div>\par
{\bkmkstart AAAAAAAEIC}{\bkmkend AAAAAAAEIC}
00211                     <div {\cf17 class}={\cf22 "popup-body"}>\par
{\bkmkstart AAAAAAAEID}{\bkmkend AAAAAAAEID}
00212                         <div {\cf17 class}={\cf22 "last-update"}>\par
{\bkmkstart AAAAAAAEIE}{\bkmkend AAAAAAAEIE}
00213                             <i {\cf17 class}={\cf22 "fas fa-clock"}></i> Hora: $\{d.time.s.substring(11, 16)\}\par
{\bkmkstart AAAAAAAEIF}{\bkmkend AAAAAAAEIF}
00214                         </div>\par
{\bkmkstart AAAAAAAEIG}{\bkmkend AAAAAAAEIG}
00215                         <ul {\cf17 class}={\cf22 "pollutant-list"}>\par
{\bkmkstart AAAAAAAEIH}{\bkmkend AAAAAAAEIH}
00216                             $\{listadoHtml || {\cf22 '<li>Datos generales solo</li>'}\}\par
{\bkmkstart AAAAAAAEII}{\bkmkend AAAAAAAEII}
00217                         </ul>\par
{\bkmkstart AAAAAAAEIJ}{\bkmkend AAAAAAAEIJ}
00218                         <div {\cf17 class}={\cf22 "popup-footer"}>\par
{\bkmkstart AAAAAAAEIK}{\bkmkend AAAAAAAEIK}
00219                             Fuente: $\{d.attributions[0]?.name || {\cf22 'GVA'}\}\par
{\bkmkstart AAAAAAAEIL}{\bkmkend AAAAAAAEIL}
00220                         </div>\par
{\bkmkstart AAAAAAAEIM}{\bkmkend AAAAAAAEIM}
00221                     </div>\par
{\bkmkstart AAAAAAAEIN}{\bkmkend AAAAAAAEIN}
00222                 </div>\par
{\bkmkstart AAAAAAAEIO}{\bkmkend AAAAAAAEIO}
00223             `;\par
{\bkmkstart AAAAAAAEIP}{\bkmkend AAAAAAAEIP}
00224             marker.setPopupContent(html);\par
{\bkmkstart AAAAAAAEIQ}{\bkmkend AAAAAAAEIQ}
00225         \}\par
{\bkmkstart AAAAAAAEIR}{\bkmkend AAAAAAAEIR}
00226     \} {\cf19 catch} (e) \{\par
{\bkmkstart AAAAAAAEIS}{\bkmkend AAAAAAAEIS}
00227         marker.setPopupContent({\cf22 'Error de conexi\'F3n.'});\par
{\bkmkstart AAAAAAAEIT}{\bkmkend AAAAAAAEIT}
00228     \}\par
{\bkmkstart AAAAAAAEIU}{\bkmkend AAAAAAAEIU}
00229 \}\par
{\bkmkstart AAAAAAAEIV}{\bkmkend AAAAAAAEIV}
00230 {\cf20 }\par
{\bkmkstart AAAAAAAEIW}{\bkmkend AAAAAAAEIW}
00231 {\cf20 /**}\par
{\bkmkstart AAAAAAAEIX}{\bkmkend AAAAAAAEIX}
00232 {\cf20  * @brief Devuelve un color hexadecimal seg\'FAn el nivel de AQI.}\par
{\bkmkstart AAAAAAAEIY}{\bkmkend AAAAAAAEIY}
00233 {\cf20  * @details}\par
{\bkmkstart AAAAAAAEIZ}{\bkmkend AAAAAAAEIZ}
00234 {\cf20  * - 0-50: Verde (Bueno)}\par
{\bkmkstart AAAAAAAEJA}{\bkmkend AAAAAAAEJA}
00235 {\cf20  * - 51-100: Amarillo (Moderado)}\par
{\bkmkstart AAAAAAAEJB}{\bkmkend AAAAAAAEJB}
00236 {\cf20  * - 101-150: Naranja (Insalubre para grupos sensibles)}\par
{\bkmkstart AAAAAAAEJC}{\bkmkend AAAAAAAEJC}
00237 {\cf20  * - 151-200: Rojo (Insalubre)}\par
{\bkmkstart AAAAAAAEJD}{\bkmkend AAAAAAAEJD}
00238 {\cf20  * - 201-300: Morado (Muy insalubre)}\par
{\bkmkstart AAAAAAAEJE}{\bkmkend AAAAAAAEJE}
00239 {\cf20  * - >300: Granate (Peligroso)}\par
{\bkmkstart AAAAAAAEJF}{\bkmkend AAAAAAAEJF}
00240 {\cf20  *}\par
{\bkmkstart AAAAAAAEJG}{\bkmkend AAAAAAAEJG}
00241 {\cf20  * @param \{number\} aqi - \'CDndice de Calidad del Aire.}\par
{\bkmkstart AAAAAAAEJH}{\bkmkend AAAAAAAEJH}
00242 {\cf20  * @return \{string\} Color en formato Hex.}\par
{\bkmkstart AAAAAAAEJI}{\bkmkend AAAAAAAEJI}
00243 {\cf20  */}\par
{\bkmkstart AAAAAAAEJJ}{\bkmkend AAAAAAAEJJ}
{\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAEEJ" }{}}{\fldrslt {\cs37\ul\cf2 00244}}}
 function {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAEEJ" }{}}{\fldrslt {\cs37\ul\cf2 obtenerColorAQI}}}
(aqi) \{\par
{\bkmkstart AAAAAAAEJK}{\bkmkend AAAAAAAEJK}
00245     {\cf19 if} (aqi <= 50) {\cf19 return} {\cf22 "#009966"}; \par
{\bkmkstart AAAAAAAEJL}{\bkmkend AAAAAAAEJL}
00246     {\cf19 if} (aqi <= 100) {\cf19 return} {\cf22 "#ffde33"}; \par
{\bkmkstart AAAAAAAEJM}{\bkmkend AAAAAAAEJM}
00247     {\cf19 if} (aqi <= 150) {\cf19 return} {\cf22 "#ff9933"}; \par
{\bkmkstart AAAAAAAEJN}{\bkmkend AAAAAAAEJN}
00248     {\cf19 if} (aqi <= 200) {\cf19 return} {\cf22 "#cc0033"}; \par
{\bkmkstart AAAAAAAEJO}{\bkmkend AAAAAAAEJO}
00249     {\cf19 if} (aqi <= 300) {\cf19 return} {\cf22 "#660099"};\par
{\bkmkstart AAAAAAAEJP}{\bkmkend AAAAAAAEJP}
00250     {\cf19 return} {\cf22 "#7e0023"}; \par
{\bkmkstart AAAAAAAEJQ}{\bkmkend AAAAAAAEJQ}
00251 \}\par
{\bkmkstart AAAAAAAEJR}{\bkmkend AAAAAAAEJR}
00252 \par
{\bkmkstart AAAAAAAEJS}{\bkmkend AAAAAAAEJS}
00253 {\cf20 // Exposici\'F3n global para acceso desde otros scripts}\par
{\bkmkstart AAAAAAAEJT}{\bkmkend AAAAAAAEJT}
{\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAEBG" }{}}{\fldrslt {\cs37\ul\cf2 00254}}}
 {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAABPS" }{}}{\fldrslt {\cs37\ul\cf2 window}}}
.inicializarEstacionesOficiales = {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAEBG" }{}}{\fldrslt {\cs37\ul\cf2 inicializarEstacionesOficiales}}}
;\par
}
