{\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAGDB" }{}}{\fldrslt {\cs37\ul\cf2 00260}}}
 function {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAGDB" }{}}{\fldrslt {\cs37\ul\cf2 obtenerIntensidadSegunNivel}}}
(valor, niveles) \{\par
