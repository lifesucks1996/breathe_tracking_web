{\bkmkstart AAAAAAAHHJ}{\bkmkend AAAAAAAHHJ}
{\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAHHK" }{}}{\fldrslt {\cs37\ul\cf2 00171}}}
 {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAHHK" }{}}{\fldrslt {\cs37\ul\cf2 $fecha_validez_dt}}}
 = {\cf17 null};\par
{\bkmkstart AAAAAAAHHL}{\bkmkend AAAAAAAHHL}
00172 \par
{\bkmkstart AAAAAAAHHM}{\bkmkend AAAAAAAHHM}
00173 {\cf19 if} ({\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAHGP" }{}}{\fldrslt {\cs37\ul\cf2 $validez_db}}}
