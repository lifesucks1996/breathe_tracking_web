{\bkmkstart AAAAAAAFKQ}{\bkmkend AAAAAAAFKQ}
00240             btnAdd.innerHTML = {\cf22 'Cancelar'};\par
{\bkmkstart AAAAAAAFKR}{\bkmkend AAAAAAAFKR}
00241             {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAAFU" }{}}{\fldrslt {\cs37\ul\cf2 document}}}
.getElementById({\cf22 'mapa'}).style.cursor = {\cf22 'crosshair'};\par
{\bkmkstart AAAAAAAFKS}{\bkmkend AAAAAAAFKS}
