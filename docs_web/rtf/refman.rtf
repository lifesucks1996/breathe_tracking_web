00302     {\cf17 const} gases = [{\cf22 'O3'}, {\cf22 'NO2'}, {\cf22 'CO'}, {\cf22 'SO2'}, {\cf22 'CO2'}];\par
{\bkmkstart AAAAAAAGIF}{\bkmkend AAAAAAAGIF}
