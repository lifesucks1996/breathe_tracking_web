00261     {\cf19 if} (!niveles || niveles.length === 0) {\cf19 return} 0.2; \par
{\bkmkstart AAAAAAAGGQ}{\bkmkend AAAAAAAGGQ}
00262     let colorEncontrado = {\cf22 'verde'};\par
{\bkmkstart AAAAAAAGGR}{\bkmkend AAAAAAAGGR}
00263     {\cf19 for} (let nivel of niveles) \{\par
{\bkmkstart AAAAAAAGGS}{\bkmkend AAAAAAAGGS}
00264         let cumpleMin = (nivel.min === undefined) || (valor >= nivel.min);\par
{\bkmkstart AAAAAAAGGT}{\bkmkend AAAAAAAGGT}
00265         let cumpleMax = (nivel.max === undefined) || (valor <= nivel.max);\par
{\bkmkstart AAAAAAAGGU}{\bkmkend AAAAAAAGGU}
00266         {\cf19 if} (cumpleMin && cumpleMax) \{\par
{\bkmkstart AAAAAAAGGV}{\bkmkend AAAAAAAGGV}
00267             let c = nivel.color ? nivel.color.toLowerCase() : {\cf22 'verde'};\par
{\bkmkstart AAAAAAAGGW}{\bkmkend AAAAAAAGGW}
00268             {\cf19 if} (c === {\cf22 'naranja'}) c = {\cf22 'amarillo'};\par
{\bkmkstart AAAAAAAGGX}{\bkmkend AAAAAAAGGX}
00269             {\cf19 if} (c === {\cf22 'morado'}) c = {\cf22 'rojo'};\par
{\bkmkstart AAAAAAAGGY}{\bkmkend AAAAAAAGGY}
00270             colorEncontrado = c;\par
{\bkmkstart AAAAAAAGGZ}{\bkmkend AAAAAAAGGZ}
00271             {\cf19 break};\par
{\bkmkstart AAAAAAAGHA}{\bkmkend AAAAAAAGHA}
00272         \}\par
{\bkmkstart AAAAAAAGHB}{\bkmkend AAAAAAAGHB}
00273     \}\par
{\bkmkstart AAAAAAAGHC}{\bkmkend AAAAAAAGHC}
00274     {\cf19 return} {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAFYP" }{}}{\fldrslt {\cs37\ul\cf2 INTENSIDAD_COLORES}}}
[colorEncontrado] || 0.2;\par
{\bkmkstart AAAAAAAGHD}{\bkmkend AAAAAAAGHD}
00275 \}\par
{\bkmkstart AAAAAAAGHE}{\bkmkend AAAAAAAGHE}
