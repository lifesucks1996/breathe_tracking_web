.forEach(pt => \{\par
{\bkmkstart AAAAAAAGER}{\bkmkend AAAAAAAGER}
00211         {\cf20 // Distancia Euclidiana simple (suficiente para distancias cortas)}\par
{\bkmkstart AAAAAAAGES}{\bkmkend AAAAAAAGES}
